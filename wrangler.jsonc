{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auto-line-item-zero-france",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-31",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auto-line-item-zero-france",
			"database_id": "5208a648-b537-4220-ad17-2c41407339d1",
			"migrations_dir": "migrations"
		},
		{
			"binding": "auto_line_item_zero",
			"database_name": "auto-line-item-zero-france",
			"database_id": "5208a648-b537-4220-ad17-2c41407339d1",
			"remote": true
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "JOBS",
				"queue": "auto-line-item-zero-france"
			}
		],
		"consumers": [
			{
				"queue": "auto-line-item-zero-france",
				"max_batch_size": 5,
				"max_batch_timeout": 2,
				"max_retries": 5,
